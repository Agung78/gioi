        {
          "ruleId": "strix-coverage/authentication-venue-level-authorization-and-idor",
          "ruleIndex": 0,
          "kind": "pass",
          "level": "none",
          "message": {
            "text": "Authentication, venue-level authorization, and IDOR — No issue identified: API staff routes (reservation, guest, settings, admin user operations)\n\nReviewed the route handlers and middleware: authenticated handlers call requireVenueAccess against the resource venue before returning or mutating data; admin and super-admin mutations additionally enforce requireAdmin or an explicit super-admin check."
          },
          "locations": [
            {
              "logicalLocations": [
                {
                  "fullyQualifiedName": "API staff routes (reservation, guest, settings, admin user operations)"
                }
              ]
            }
          ],
          "properties": {
