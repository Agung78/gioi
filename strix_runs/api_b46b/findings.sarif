              "coverage_outcome": "no_issue_found",
              "risk_area": "Authentication, venue-level authorization, and IDOR",
              "surface": "API staff routes (reservation, guest, settings, admin user operations)",
              "recorded_by": "API Diff Mapper",
              "source": "agent_reported"
            }
          }
        },
        {
          "ruleId": "strix-coverage/sql-nosql-query-injection",
          "ruleIndex": 1,
          "kind": "pass",
          "level": "none",
          "message": {
            "text": "SQL/NoSQL/query injection — No issue identified: API public reservation routes\n\nReviewed reservation creation, lookup, cancel, and feedback handlers. All database access uses Prisma model methods or tagged `$queryRaw`/`$executeRaw` templates with interpolated values parameter-bound; no unsafe raw-query API or dynamic query syntax found."
          },
          "locations": [
            {
              "logicalLocations": [
                {
                  "fullyQualifiedName": "API public reservation routes"
                }
              ]
            }
          ],
          "properties": {
            "strix": {
              "coverage_outcome": "no_issue_found",
              "risk_area": "SQL/NoSQL/query injection",
              "surface": "API public reservation routes",
              "recorded_by": "API Injection Specialist",
              "source": "agent_reported"
            }
          }
        },
        {
          "ruleId": "strix-coverage/sql-injection-and-unsafe-input-handling",
          "ruleIndex": 2,
          "kind": "pass",
          "level": "none",
          "message": {
            "text": "SQL injection and unsafe input handling — No issue identified: API public reservation and venue endpoints\n\nPublic route inputs are handled through Prisma filters or parameterized tagged raw SQL; request schemas constrain key identifiers and booking fields, and custom table-selection validation checks venue membership before mutation."
          },
          "locations": [
            {
              "logicalLocations": [
                {
                  "fullyQualifiedName": "API public reservation and venue endpoints"
                }
              ]
            }
          ],
          "properties": {
