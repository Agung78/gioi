              "risk_area": "SQL injection and unsafe input handling",
              "surface": "API public reservation and venue endpoints",
              "recorded_by": "API Diff Mapper",
              "source": "agent_reported"
            }
          }
        },
        {
          "ruleId": "strix-coverage/sql-nosql-query-injection",
          "ruleIndex": 1,
          "kind": "pass",
          "level": "none",
          "message": {
            "text": "SQL/NoSQL/query injection — No issue identified: API public venue routes\n\nReviewed public venue, availability, and table-availability handlers; they use Prisma `findUnique`/`findMany` with structured filters. Date/time and integer inputs feed domain conversion and parameterized ORM fields, not SQL syntax."
          },
          "locations": [
            {
              "logicalLocations": [
                {
                  "fullyQualifiedName": "API public venue routes"
                }
              ]
            }
          ],
          "properties": {
