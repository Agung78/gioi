{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "declaration": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "@prisma/client": ["./src/generated/prisma/client"],
      "@gioi/domain": ["../../packages/domain/src/index.ts"]
    }
  },
  "include": ["src/**/*", "prisma/**/*"]
}
