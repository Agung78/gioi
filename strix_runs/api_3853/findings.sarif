      "results": [
        {
          "ruleId": "CWE-200",
          "ruleIndex": 0,
          "level": "warning",
          "message": {
            "text": "Unauthenticated Nuxt dev server exposes application source through Vite endpoints\n\nThe deployed frontend is running Nuxt’s development server and serves transformed application source, Vite client code, and absolute local paths to unauthenticated requests. The changed `NUXT_DEV_HOST` override permits external binding, making these development endpoints reachable on the network."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "nuxt.config.ts"
                },
                "region": {
                  "startLine": 6,
                  "endLine": 6,
                  "snippet": {
                    "text": "devServer: { host: process.env.NUXT_DEV_HOST ?? '127.0.0.1' },"
                  }
                }
              },
              "message": {
                "text": "Externally controllable dev-server binding"
              }
            },
            {
              "logicalLocations": [
                {
                  "fullyQualifiedName": "/_nuxt/@fs/Users/heyrcg/Documents/Works/gioi/apps/web/nuxt.config.ts",
                  "kind": "endpoint"
                }
              ]
            }
          ],
          "fixes": [
            {
              "artifactChanges": [
                {
                  "artifactLocation": {
                    "uri": "nuxt.config.ts"
                  },
                  "replacements": [
                    {
                      "deletedRegion": {
                        "startLine": 6,
                        "endLine": 6
                      },
                      "insertedContent": {
                        "text": "devServer: { host: '127.0.0.1' }"
                      }
                    }
                  ]
                }
              ],
              "description": {
                "text": "Do not run `nuxt dev` for any externally reachable deployment. Build the application with Nuxt and serve the generated `.output` server using the production start command. Remove the externally controllable `NUXT_DEV_HOST` override and keep the development server bound to loopback. Disable Nuxt DevTools in production and ensure reverse proxies expose only the built application routes, not `/_nuxt/@fs/` or `/_nuxt/@vite/`.",
                "markdown": "Do not run `nuxt dev` for any externally reachable deployment. Build the application with Nuxt and serve the generated `.output` server using the production start command. Remove the externally controllable `NUXT_DEV_HOST` override and keep the development server bound to loopback. Disable Nuxt DevTools in production and ensure reverse proxies expose only the built application routes, not `/_nuxt/@fs/` or `/_nuxt/@vite/`."
              }
            }
          ],
          "partialFingerprints": {
            "primaryLocationLineHash": "ddb4a0e7a984001630c27a1acf13e48dd17f06d56b73ef07e79601e1345b134c"
          },
          "properties": {
            "security-severity": "5.3",
            "strix_vuln_class_hash": "7b752c2cf92eb4f1462f508c1b335fbf1927ff5446366e2f3eca68e82b7b089a",
            "strix": {
              "id": "vuln-0001",
              "severity": "medium",
              "cvss": 5.3,
              "timestamp": "2026-11-11 06:20:35 UTC",
              "target": "http://host.docker.internal:3002",
              "endpoint": "/_nuxt/@fs/Users/heyrcg/Documents/Works/gioi/apps/web/nuxt.config.ts",
              "method": "GET",
              "cwe": "CWE-200",
              "impact": "An unauthenticated attacker can retrieve `nuxt.config.ts`, `app.vue`, and other application modules plus dependency paths and dev-server metadata. This exposes implementation details and any future source-embedded secrets, materially reducing the effort required to target server and client logic.",
              "technical_analysis": "The changed configuration explicitly binds the Nuxt dev server to `process.env.NUXT_DEV_HOST`, allowing an externally supplied host instead of enforcing loopback. The live service responds with transformed source at `/_nuxt/@fs/.../nuxt.config.ts` and `/_nuxt/@fs/.../app.vue`, and the returned module imports `/_nuxt/@vite/client` and absolute `/Users/...` filesystem paths. Vite’s allow-list blocks `/etc/passwd` and the API `.env`, but that restriction does not prevent reads of application files under the allowed workspace. Development servers must not be exposed as production HTTP services.",
              "remediation_steps": "Do not run `nuxt dev` for any externally reachable deployment. Build the application with Nuxt and serve the generated `.output` server using the production start command. Remove the externally controllable `NUXT_DEV_HOST` override and keep the development server bound to loopback. Disable Nuxt DevTools in production and ensure reverse proxies expose only the built application routes, not `/_nuxt/@fs/` or `/_nuxt/@vite/`.",
              "counterevidence": "Vite rejects paths outside its configured filesystem allow-list, including `/etc/passwd` and the API `.env`, and therefore this is not unrestricted host filesystem disclosure. However, application source files inside the allowed workspace remain readable, and no authentication or production-mode guard protects the dev endpoints.",
              "confidence": "high",
              "severity_change_conditions": "Demonstrating source-embedded credentials or signing material in the exposed modules would raise confidentiality impact and severity; proving the service is strictly loopback-only would lower network exploitability.",
              "fix_verification": "Security closure: forcing the dev server to loopback prevents remote clients from reaching Vite `/_nuxt/@fs/` and `/_nuxt/@vite/` when this configuration is used directly. Bypass review: the changed line has no alternate environment override; Vite’s `/@fs` and HMR paths share the same listener, while production deployment must additionally use the built Nuxt output rather than `nuxt dev`. Preserved behavior: local development remains available on loopback and the existing Nuxt configuration/API behavior is unchanged. Repository check: `npx nuxt typecheck` was not run because the report does not modify the checkout; the replacement is syntactically valid TypeScript. Deployment-mode verification remains a gap unless the service is restarted with the patched configuration.",
              "poc": {
                "description": "1. Send an unauthenticated `GET` request for the transformed `nuxt.config.ts` file under the `/_nuxt/@fs/` prefix.\n2. Observe `200 OK` with JavaScript source containing the Nuxt configuration and the `NUXT_DEV_HOST` binding.\n3. Send an unauthenticated `GET` request for `/_nuxt/@fs/.../app.vue` and observe transformed source importing `/_nuxt/@vite/client` and absolute dependency paths.\n4. Confirm the service is a development server by observing `Cache-Control: no-cache` and Vite HMR client code.",
                "script_available": true
              }
            }
          }
        },
