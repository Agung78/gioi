{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Strix",
          "informationUri": "https://strix.ai",
          "rules": [
            {
              "id": "CWE-200",
              "name": "Unauthenticated Nuxt dev server exposes application source through Vite endpoints",
              "shortDescription": {
                "text": "Unauthenticated Nuxt dev server exposes application source through Vite endpoints"
              },
              "fullDescription": {
                "text": "The deployed frontend is running Nuxt’s development server and serves transformed application source, Vite client code, and absolute local paths to unauthenticated requests. The changed `NUXT_DEV_HOST` override permits external binding, making these development endpoints reachable on the network."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "help": {
                "text": "The deployed frontend is running Nuxt’s development server and serves transformed application source, Vite client code, and absolute local paths to unauthenticated requests. The changed `NUXT_DEV_HOST` override permits external binding, making these development endpoints reachable on the network.\n\nAn unauthenticated attacker can retrieve `nuxt.config.ts`, `app.vue`, and other application modules plus dependency paths and dev-server metadata. This exposes implementation details and any future source-embedded secrets, materially reducing the effort required to target server and client logic.\n\nDo not run `nuxt dev` for any externally reachable deployment. Build the application with Nuxt and serve the generated `.output` server using the production start command. Remove the externally controllable `NUXT_DEV_HOST` override and keep the development server bound to loopback. Disable Nuxt DevTools in production and ensure reverse proxies expose only the built application routes, not `/_nuxt/@fs/` or `/_nuxt/@vite/`.",
                "markdown": "The deployed frontend is running Nuxt’s development server and serves transformed application source, Vite client code, and absolute local paths to unauthenticated requests. The changed `NUXT_DEV_HOST` override permits external binding, making these development endpoints reachable on the network.\n\nAn unauthenticated attacker can retrieve `nuxt.config.ts`, `app.vue`, and other application modules plus dependency paths and dev-server metadata. This exposes implementation details and any future source-embedded secrets, materially reducing the effort required to target server and client logic.\n\nDo not run `nuxt dev` for any externally reachable deployment. Build the application with Nuxt and serve the generated `.output` server using the production start command. Remove the externally controllable `NUXT_DEV_HOST` override and keep the development server bound to loopback. Disable Nuxt DevTools in production and ensure reverse proxies expose only the built application routes, not `/_nuxt/@fs/` or `/_nuxt/@vite/`."
              },
              "properties": {
                "security-severity": "5.3",
                "tags": [
                  "security",
                  "CWE-200",
                  "stride:I"
                ]
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/200.html"
            },
