{
  "name": "@gioi/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc --noEmit",
    "test": "vitest run --exclude 'src/**/__tests__/db/**' --passWithNoTests",
    "test:db": "vitest run --config vitest.db.config.ts",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:seed": "prisma db seed"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.0",
    "@fastify/cors": "^10.0.0",
    "@node-rs/argon2": "^2.0.0",
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "7.10.1",
    "fastify": "^5.0.0",
    "prisma": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "supertest": "^7.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
